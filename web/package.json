{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node -e \"const fs=require('fs');if(fs.existsSync('../shared/content.ts'))fs.copyFileSync('../shared/content.ts','lib/content.ts')\"",
    "predev": "npm run sync",
    "dev": "next dev --turbopack",
    "prebuild": "npm run sync",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.5.27"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "@eslint/eslintrc": "^3"
  }
}
